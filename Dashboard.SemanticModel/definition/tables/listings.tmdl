table listings
	lineageTag: eba179c0-b9b2-4e91-954a-890d83088d32

	/// Number of listings (one row per listing)
	measure Listings = COUNTROWS(listings)
		formatString: #,0
		lineageTag: 7d1e4a52-3c6b-4f0e-9a1d-2b8c5e6f7a01

	/// Median nightly price; median is used because a few very expensive listings pull the average up
	measure 'Median Price' = MEDIAN(listings[price])
		formatString: \$#,0
		lineageTag: 7d1e4a52-3c6b-4f0e-9a1d-2b8c5e6f7a02

	/// Total number of reviews, a rough proxy for demand
	measure 'Total Reviews' = SUM(listings[number_of_reviews])
		formatString: #,0
		lineageTag: 7d1e4a52-3c6b-4f0e-9a1d-2b8c5e6f7a03

	/// Average days per year a listing is open for booking
	measure 'Avg Availability (days)' = AVERAGE(listings[availability_365])
		formatString: 0
		lineageTag: 7d1e4a52-3c6b-4f0e-9a1d-2b8c5e6f7a04

	column id
		dataType: int64
		formatString: 0
		lineageTag: 0f3c6186-586b-40ba-abe0-0503c00cf81c
		summarizeBy: none
		sourceColumn: id

		annotation SummarizationSetBy = User

