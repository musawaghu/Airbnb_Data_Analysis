		annotation SummarizationSetBy = User

	/// Readable label for room_type (0/1/2), added in Power Query
	column 'Room Type'
		dataType: string
		lineageTag: 3a9e2f61-8b4d-4c7e-b0a5-6d1f2e3c4b05
		summarizeBy: none
		sourceColumn: Room Type

		annotation SummarizationSetBy = Automatic

	column host_name
		dataType: string
		lineageTag: 177212db-1b7e-4652-83ff-7deef3d22716
		summarizeBy: none
		sourceColumn: host_name

		annotation SummarizationSetBy = Automatic

	/// Average latitude of the listing's borough, so the map draws one bubble per borough
	column borough_latitude = CALCULATE(AVERAGE(listings[latitude]), ALLEXCEPT(listings, listings[neighbourhood_group]))
		lineageTag: 59d484e4-02c2-46b8-ab2b-54db16f50125
		dataCategory: Latitude
		summarizeBy: none

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Average longitude of the listing's borough, so the map draws one bubble per borough
	column borough_longitude = CALCULATE(AVERAGE(listings[longitude]), ALLEXCEPT(listings, listings[neighbourhood_group]))
		lineageTag: 8357fdcc-536a-490f-aa14-f9f80b04fe6e
		dataCategory: Longitude
		summarizeBy: none

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition listings = m
		mode: import
		source =
				let
				    Source = Python.Execute("import pandas as pd#(lf)import sqlite3#(lf)conn = sqlite3.connect(r""C:\Users\Musa Waghu\PycharmProjects\Airbnb_Data_Analysis\airbnb.db"")#(lf)listings = pd.read_sql(""SELECT * FROM listings"", conn)"),
				    listings1 = Source{[Name="listings"]}[Value],
				    // The Python connector hands every column over as text, so set the real number types
				    Typed = Table.TransformColumnTypes(listings1, {{"id", Int64.Type}, {"host_id", Int64.Type}, {"latitude", type number}, {"longitude", type number}, {"room_type", Int64.Type}, {"price", type number}, {"minimum_nights", Int64.Type}, {"number_of_reviews", Int64.Type}, {"availability_365", Int64.Type}}, "en-US"),
				    // main.py stores room type as 0/1/2; turn it back into readable labels
				    WithRoomType = Table.AddColumn(Typed, "Room Type", each if [room_type] = 0 then "Entire home/apt" else if [room_type] = 1 then "Private room" else "Shared room", type text)
				in
				    WithRoomType

	annotation PBI_ResultType = Table

